{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Frontend Server",
            "type": "shell",
            "command": "pnpm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "presentation": {
                "group": "dev-servers",
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "Backend Server",
            "type": "shell",
            "command": "python manage.py runserver 0.0.0.0:8000",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "group": "dev-servers",
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "dev",
            "dependsOn": [
                "Frontend Server",
                "Backend Server"
            ],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "close": true
            },
            "problemMatcher": []
        }
    ]
}
